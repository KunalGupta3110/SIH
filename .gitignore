# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

# YOLO & PyTorch weights
*.pt
*.pth
*.onnx
# ...except the one shipped to the browser for client-side detection
# (frontend/src/lib/clientYolo.js) — this IS a runtime asset the app needs.
!frontend/public/models/*.onnx

# Video output & test recordings (large files)
*.mp4
*.avi
*.mkv
!data/sample_*.mp4
!frontend/public/data/*web.mp4

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Node (root Capacitor project)
node_modules/

# SQLite write-ahead-log sidecars (the .db itself is tracked as demo data)
data/*.db-wal
data/*.db-shm

# Local dev env for the Vite frontend — .env (bare, no .local) is loaded by
# Vite into PRODUCTION builds too, so a machine-specific VITE_API_BASE must
# never get committed here (the dev-server proxy in vite.config.js covers
# local dev instead; production talks to window.location.origin).
frontend/.env
frontend/.env.local
frontend/.env.*.local
data/events.db
data/*.db

# runtime-generated evidence crops from alerts/run_surveillance.py and the
# live multi-camera engine (core/vision/multi_stream_engine.py)
data/thumbnails/evt_int_*
data/thumbnails/evt_loit_*
data/thumbnails/evt_tw_*
data/thumbnails/evt_live_*
