# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

# YOLO & PyTorch weights
*.pt
*.pth
*.onnx

# Video output & test recordings (large files)
*.mp4
*.avi
*.mkv
!data/sample_*.mp4
!frontend/public/data/*web.mp4

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Node (root Capacitor project)
node_modules/

# SQLite write-ahead-log sidecars (the .db itself is tracked as demo data)
data/*.db-wal
data/*.db-shm

# Local dev env for the Vite frontend
frontend/.env.local
frontend/.env.*.local
